-- TEAM CHECK
local TEAM_MARKERS = {"StageTeamSide", "Team", "TeamName", "TeamColor", "TeamId", "TeamID", "team"}
local function readTeamMarker(instance)
    if not instance then return nil end
    for _, name in ipairs(TEAM_MARKERS) do
        local attr = instance:GetAttribute(name)
        if attr ~= nil then return name .. "=" .. tostring(attr) end
        local child = instance:FindFirstChild(name)
        if child and child:IsA("ValueBase") then return name .. "=" .. tostring(child.Value) end
    end
    return nil
end
local function getCustomTeamIdentity(targetPlayer)
    if not targetPlayer then return nil end
    local marker = readTeamMarker(targetPlayer) or readTeamMarker(targetPlayer.Character)
    if marker then return marker end
    local stats = targetPlayer:FindFirstChild("leaderstats")
    marker = readTeamMarker(stats)
    if marker then return marker end
    if not targetPlayer.Neutral then return "TeamColor=" .. tostring(targetPlayer.TeamColor) end
    return nil
end
local customTeamCache = { count = 0, at = 0 }
local function getCustomTeamCount()
    local now = os.clock()
    if now - customTeamCache.at > 0.5 then
        local seen, count = {}, 0
        for _, p in ipairs(Players:GetPlayers()) do
            local id = getCustomTeamIdentity(p)
            if id and not seen[id] then seen[id] = true; count = count + 1 end
        end
        customTeamCache.count = count
        customTeamCache.at = now
    end
    return customTeamCache.count
end
local function isTeammate(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false end
    if LocalPlayer.Team and targetPlayer.Team then return LocalPlayer.Team == targetPlayer.Team end
    local lTeam = getCustomTeamIdentity(LocalPlayer)
    local tTeam = getCustomTeamIdentity(targetPlayer)
    if not lTeam or not tTeam then return false end
    return getCustomTeamCount() >= 2 and lTeam == tTeam
end
local function isEnemyPlayer(player)
    if not TeamCheck then return true end
    if player == LocalPlayer then return false end
    return not isTeammate(player)
end

-- GARAPAL SILENT AIM & GC HOOKS
local isShootingBlaster = false
local function getClosestTargetInFOV()
    local bestPart, bestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and isEnemyPlayer(player) then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < GarapalFOVRadius and dist < bestDist then
                        bestDist = dist
                        bestPart = head
                    end
                end
            end
        end
    end
    return bestPart
end

local function isValidEnemyHit(hitInstance)
    if not hitInstance then return false end
    local model = hitInstance:FindFirstAncestorOfClass("Model")
    if not model or model == LocalPlayer.Character then return false end
    local hitPlayer = Players:GetPlayerFromCharacter(model)
    if hitPlayer and not isEnemyPlayer(hitPlayer) then return false end
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

if getrawmetatable and setreadonly then
    local wsMeta = getrawmetatable(workspace)
    if wsMeta then
        local origNC = wsMeta.__namecall
        setreadonly(wsMeta, false)
        wsMeta.__namecall = function(self, ...)
            local method = getnamecallmethod()
            if isShootingBlaster and self == workspace and (method == "Spherecast" or method == "Raycast") then
                local args = { ... }
                local hitResult = origNC(self, table.unpack(args))
                if hitResult and hitResult.Instance then
                    if isValidEnemyHit(hitResult.Instance) then return hitResult end
                    local ignored = { hitResult.Instance }
                    if hitResult.Instance.Parent then table.insert(ignored, hitResult.Instance.Parent) end
                    for _ = 1, 10 do
                        local rp
                        if args[3] and typeof(args[3]) == "RaycastParams" then rp = args[3]
                        elseif args[4] and typeof(args[4]) == "RaycastParams" then rp = args[4] end
                        if rp then
                            local fl = rp.FilterDescendantsInstances or {}
                            for _, i in ipairs(ignored) do table.insert(fl, i) end
                            rp.FilterDescendantsInstances = fl
                        end
                        local retry = origNC(self, table.unpack(args))
                        if not retry then break end
                        if isValidEnemyHit(retry.Instance) then return retry end
                        table.insert(ignored, retry.Instance)
                        if retry.Instance.Parent then table.insert(ignored, retry.Instance.Parent) end
                    end
                    return nil
                end
                return hitResult
            end
            return origNC(self, ...)
        end
        setreadonly(wsMeta, true)
    end
end

task.delay(3, function()
    if not getgc then return end
    pcall(function()
        local scanned = 0
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "shoot") and rawget(obj, "reload") and rawget(obj, "recoil") and rawget(obj, "canShoot") and rawget(obj, "getShotOrigin") and rawget(obj, "isWallBlockingShot") and not rawget(obj, "__hooked") then
                obj.__hooked = true
                
                local origRecoil = obj.recoil
                obj.recoil = function(self, ...)
                    if GarapalNoRecoilEnabled or NoRecoilEnabled then return end
                    if origRecoil then return origRecoil(self, ...) end
                end

                local origWallCheck = obj.isWallBlockingShot
                obj.isWallBlockingShot = function(self, ...)
                    if GarapalNoRecoilEnabled or NoRecoilEnabled then return false end
                    if origWallCheck then return origWallCheck(self, ...) end
                    return false
                end

                local origGetSecondsPerShot = obj.getSecondsPerShot
                obj.getSecondsPerShot = function(self, ...)
                    if GarapalRapidFireEnabled or RapidFireEnabled then return GarapalFIRE_RATE_INTERVAL end
                    if origGetSecondsPerShot then return origGetSecondsPerShot(self, ...) end
                    return 0.1
                end

                local origStartShooting = obj.startShooting
                obj.startShooting = function(self, ...)
                    if GarapalRapidFireEnabled or RapidFireEnabled then
                        if self:canShoot() and not self.shooting then
                            if self.startAutoFireWhileHeld then
                                self:startAutoFireWhileHeld(GarapalFIRE_RATE_INTERVAL)
                            elseif origStartShooting then origStartShooting(self, ...) end
                        end
                        return
                    end
                    if origStartShooting then return origStartShooting(self, ...) end
                end

                local origGetShotOrigin = obj.getShotOrigin
                obj.getShotOrigin = function(self, ...)
                    local originCF, maxDist = origGetShotOrigin(self, ...)
                    if GarapalSilentAimEnabled then
                        local th = getClosestTargetInFOV()
                        if th then
                            local op = originCF.Position
                            local tp = th.Position
                            return CFrame.lookAt(op, tp), (tp - op).Magnitude + 10
                        end
                    end
                    return originCF, maxDist
                end

                local origShoot = obj.shoot
                obj.shoot = function(self, ...)
                    if GarapalNoRecoilEnabled or NoRecoilEnabled then
                        if self.blaster then pcall(function() self.blaster:SetAttribute("Spread", 0) end) end
                    end
                    isShootingBlaster = true
                    origShoot(self, ...)
                    isShootingBlaster = false
                end
            end
            scanned = scanned + 1
            if scanned % 300 == 0 then task.wait() end
        end
    end)
end)

