local function addSlider(parentPage, labelText, minVal, maxVal, defaultVal, isFloat, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 54)
    row.BackgroundColor3 = BG_ROW
    row.ZIndex = 2
    row.Parent = parentPage
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local rs = Instance.new("UIStroke", row)
    rs.Color = STROKE_WHITE
    rs.Thickness = 1
    rs.Transparency = 0.8
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -24, 0, 22)
    label.Position = UDim2.new(0, 14, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = labelText .. ": " .. (isFloat and string.format("%.2f", defaultVal) or tostring(defaultVal))
    label.TextColor3 = TEXT_MAIN
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 3
    label.Parent = row
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -24, 0, 6)
    bar.Position = UDim2.new(0, 12, 0, 36)
    bar.BackgroundColor3 = BG_OFF
    bar.ZIndex = 3
    bar.Parent = row
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame")
    local initialPercent = (defaultVal - minVal) / (maxVal - minVal)
    fill.Size = UDim2.new(initialPercent, 0, 1, 0)
    fill.BackgroundColor3 = WHITE
    fill.ZIndex = 4
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local draggingSlider = false
    local function updateSlider(input)
        local percent = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        local raw = minVal + (maxVal - minVal) * percent
        local val = isFloat and math.floor(raw * 100 + 0.5) / 100 or math.floor(raw + 0.5)
        label.Text = labelText .. ": " .. (isFloat and string.format("%.2f", val) or tostring(val))
        callback(val)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            updateSlider(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    return row
end

