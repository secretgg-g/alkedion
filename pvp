-- AIMBOT
local function GetClosestAimTarget()
    local closest, shortest = nil, FOV
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if not isEnemyPlayer(plr) then continue end
            local head = plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < shortest then
                        if WallCheck then
                            local rp = RaycastParams.new()
                            rp.FilterDescendantsInstances = {Camera, LocalPlayer.Character, plr.Character}
                            rp.FilterType = Enum.RaycastFilterType.Exclude
                            local ray = workspace:Raycast(Camera.CFrame.Position, head.Position - Camera.CFrame.Position, rp)
                            if ray then continue end
                        end
                        shortest = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not AimEnabled then return end
    local target = GetClosestAimTarget()
    if target then
        local targetCF = CFrame.new(Camera.CFrame.Position, target.Position)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, TrackingStrength)
    end
end)

